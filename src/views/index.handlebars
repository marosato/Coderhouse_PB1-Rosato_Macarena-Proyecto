<h1>Productos disponibles</h1>

{{#if products.length}}
  {{#each products}}
    <div class="card">
      <strong>{{this.title}}</strong> - ${{this.price}}
      <br>
      <span class="badge">Categoría: {{this.category}}</span>

      <div class="actions">
        <a href="/products/{{this._id}}">🔍 Ver detalle</a>

        <form class="inline" action="/api/carts/{{../cartId}}/product/{{this._id}}" method="POST">
          <button type="submit">🛒 Agregar al carrito</button>
        </form>
      </div>
    </div>
  {{/each}}
{{else}}
  <div class="empty">
    No hay productos para mostrar.
  </div>
{{/if}}

<div class="pagination">
  {{#if hasPrevPage}}
    <a href="/products?page={{prevPage}}{{#if query}}&query={{query}}{{/if}}{{#if sort}}&sort={{sort}}{{/if}}">⬅ Anterior</a>
  {{/if}}

  <strong>Página {{page}} de {{totalPages}}</strong>

  {{#if hasNextPage}}
    <a href="/products?page={{nextPage}}{{#if query}}&query={{query}}{{/if}}{{#if sort}}&sort={{sort}}{{/if}}">Siguiente ➡</a>
  {{/if}}
</div>